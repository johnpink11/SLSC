\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Comparison of context representations at Turn 3 of a multi-turn mathematical reasoning task. \textbf  {Left}: Natural-language summary embeds constraints in prose, requiring attention over unstructured text to locate key facts (highlighted). \textbf  {Right}: SLSC maintains atomic propositions in numbered slots, giving each constraint a persistent and addressable location. SLSC reduces token count by $\sim $70\% while improving constraint retrievability.}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:comparison}{{1}{2}{Comparison of context representations at Turn 3 of a multi-turn mathematical reasoning task. \textbf {Left}: Natural-language summary embeds constraints in prose, requiring attention over unstructured text to locate key facts (highlighted). \textbf {Right}: SLSC maintains atomic propositions in numbered slots, giving each constraint a persistent and addressable location. SLSC reduces token count by $\sim $70\% while improving constraint retrievability}{figure.caption.1}{}}
